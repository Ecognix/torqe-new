# Server-side only. Never expose this key in the browser or commit it.
NVIDIA_API_KEY=nvapi-your-key-here

# MiniMax M3.1 Flash on NVIDIA NIM.
NVIDIA_MODEL=minimaxai/minimax-m3.1-flash
# Required for chat and website demo/pilot submissions.
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=Torqe <verified-sender@your-domain.com>
# Optional. Used only when a message has images; choose a model enabled for vision on your NVIDIA account.
# NVIDIA_VISION_MODEL=meta/llama-4-maverick-17b-128e-instruct
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# CHAT_RATE_LIMIT=12        # messages per IP per minute
